{
  "name": "sth-herdr-connector",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest run",
    "bundle": "bun build src/app/server.ts --target=bun --outfile dist/sth-herdr-connector.js"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@sth-herdr/protocol": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
